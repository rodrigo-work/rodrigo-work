{
  "name": "@rodrigo-work/cli",
  "version": "1.0.4",
  "type": "module",
  "description": "A CLI for rodrigo.work",
  "keywords": [
    "CLI",
    "NodeJS"
  ],
  "main": "dist/index.js",
  "bin": {
    "@rodrigo-work/cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "build": "tsup",
    "build:prod": "pnpm build && npm version patch --no-git-tag-version && npx javascript-obfuscator dist --output dist --self-defending true",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test vitest run",
    "clean": "git clean -xdf .cache .turbo .next dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "5.8.2",
    "zod": "^4.1.9"
  }
}
