{
  "name": "@rodrigo-work/core",
  "version": "0.0.1",
  "description": "Core module of rodrigo.work ecosystem.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Rodrigo Ribeiro",
    "url": "https://rodrigo.work"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigo-work/rodrigo-work.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "core",
    "rodrigo-work"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "clean": "git clean -xdf .cache dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0"
  }
}
