{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepublish": "echo 'This package is not intended to be published.' && exit 1",
    "build": "next build",
    "build:prod": "pnpm build && pnpm version patch --no-git-tag-version",
    "dev": "next dev --turbopack",
    "start": "next start",
    "analyze": "ANALYZE=true && pnpm run build",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "clean": "git clean -xdf .cache .turbo .next .source dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@repo/next-config": "workspace:*",
    "@repo/seo": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "15.8.1",
    "fumadocs-mdx": "12.0.1",
    "fumadocs-ui": "15.8.1",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shiki": "^3.12.2",
    "tailwind-merge": "^3.3.1",
    "workbox-window": "^7.3.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
